# --- Application Settings ---
LOG_LEVEL=INFO
PRODUCTION=False
API_PATH_PREFIX=
ENGINEERING_API_ENABLED=True
SDP_SCRIPT_TMDATA=

# --- ODA Configuration ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=oda
PGUSER=oda_admin
PGPASSWORD=

# --- Auth Configuration ---
# Staging (test:) audiences, matching the staging Indigo and User Portal below
SKA_AUTH_AUDIENCE=test:pht,test:odt
PIPELINE_TESTS_DEPLOYMENT=False

# --- Email Configuration ---
PHT_EMAIL_USER=
PHT_EMAIL_PASSWORD=

# --- S3 Configuration ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PHT_BUCKET_NAME=
AWS_REGION=
PRESIGNED_URL_EXPIRY_TIME=60

# --- User Portal Configuration ---
USER_PORTAL_BASE_URL=https://user-portal.staging.devx.skao.int
USER_PORTAL_TIMEOUT=10
USER_PORTAL_TOKEN_URL=https://iam-1.staging.devx.skao.int/token
USER_PORTAL_CLIENT_ID=80e7100b-6ada-486a-b82c-8a159ddeda4d
USER_PORTAL_CLIENT_SECRET=
# Space-separated, so keep the quotes (dotenv parsers stop at the first unquoted space)
USER_PORTAL_TOKEN_SCOPE="portal:users.read portal:groups.read portal:groups.write portal:invites.read portal:invites.write"
USER_PORTAL_TOKEN_AUDIENCE=test:portal

# --- PHT Group Names ---
# Each suffix is appended to the base name; a "/" in one makes a subgroup
PHT_GROUP_BASE="app:pht:{skuid}"
PHT_GROUP_COI_SUFFIX=/w
PHT_GROUP_PI_SUFFIX=/w/a
PHT_GROUP_CHAIR_SUFFIX=/w/a
